# ==========================================
# Frontend — public configuration only
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_MOCK_USD_ADDRESS=

# ==========================================
# Backend — never copied into frontend bundles
# ==========================================
PORT=4000
HOST=127.0.0.1
# Comma-separated list of allowed browser origins. The first one defines the SIWE domain and URI.
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/minga.sqlite
EVIDENCE_STORAGE_PATH=./data/evidence
# Replace with a random value (>= 32 chars). The backend refuses this placeholder when NODE_ENV=production.
SESSION_SECRET=a_very_secret_key_at_least_32_characters_long_for_sessions
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
FACTORY_ADDRESS=
FACTORY_DEPLOYMENT_BLOCK=0
MOCK_USD_ADDRESS=

# Optional model-assisted review. Only "groq" is implemented (OpenAI-compatible API). Leave AI_PROVIDER=none to use
# document checks only. The text of submitted evidence files is sent to the provider when enabled.
AI_PROVIDER=none
# Default when empty: llama-3.3-70b-versatile
AI_MODEL=
AI_API_KEY=

# ==========================================
# MPP / Parallel paid research — backend only
# ==========================================
MPP_ENABLED=false
MPP_PARALLEL_BASE_URL=https://parallelmpp.dev
MPP_PAYMENT_METHOD=tempo
MPP_MAX_SPEND_PER_REVIEW_USD=0.05
MPP_MAX_CALLS_PER_REVIEW=5
MPP_MAX_EXTRACT_URLS_PER_REVIEW=3
# Private key (0x + 64 hex) of a SEPARATE operational account that pays for research. Never an agreement or
# participant key. Only the "tempo" payment method is implemented. If MPP_ENABLED=true but this is missing
# or invalid, research is switched off and the API reports the real reason.
MPP_ACCOUNT_PRIVATE_KEY=

# ==========================================
# Contract deployment/seed scripts only
# ==========================================
DEPLOYER_PRIVATE_KEY=
