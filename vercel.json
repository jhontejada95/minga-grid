{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --include-workspace-root --workspace=@minga/shared --workspace=@minga/frontend",
  "buildCommand": "npm run build --workspace=@minga/shared && npm run build --workspace=@minga/frontend",
  "outputDirectory": "apps/frontend/.next"
}
